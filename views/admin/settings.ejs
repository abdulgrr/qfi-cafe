<%- include('../partials/header') %>

<!-- CROPPER.JS ASSETS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<main class="admin-container" style="max-width: 1000px;">
  <!-- ADMIN NAVIGATION HEADER -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--text-dark); display: flex; align-items: center; gap: 0.6rem;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        Site İçeriği & Genel Ayarlar
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.25rem;">
        Sitedeki tüm yazıları, logoyu ve fotoğrafları buradan kolayca değiştirebilirsiniz. Hangi yazının nerede çıktığı açıkça belirtilmiştir.
      </p>
    </div>

    <!-- ACTION BUTTONS -->
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <a href="/admin/dashboard" class="btn-outline" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; font-size: 0.9rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Menü & Ürünler
      </a>
      <a href="/" target="_blank" class="btn-outline" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; font-size: 0.9rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Siteyi Görüntüle
      </a>
      <a href="/admin/logout" class="btn-outline" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; font-size: 0.9rem; color: var(--accent-red); border-color: var(--accent-red);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Çıkış
      </a>
    </div>
  </div>

  <!-- SUCCESS / ERROR ALERTS -->
  <% if (typeof isSaved !== 'undefined' && isSaved) { %>
    <div style="background: #E8F5E9; border: 1px solid #A5D6A7; color: #2E7D32; padding: 1rem 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <div>
        <strong>Harika!</strong> Değişiklikleriniz başarıyla kaydedildi ve canlı sitede hemen güncellendi.
      </div>
    </div>
  <% } %>

  <!-- SUPABASE TABLE STATUS ALERT -->
  <% if (typeof supabaseReady !== 'undefined' && !supabaseReady) { %>
    <div style="background: #FFFBEB; border: 1px solid #FDE68A; color: #92400E; padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 2rem;">
      <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div style="flex: 1;">
          <strong style="color: #B45309; font-size: 1rem; display: block; margin-bottom: 0.35rem;">Önemli: Supabase Veritabanı Tablosu Kurulmalı</strong>
          <p style="font-size: 0.88rem; color: #4B5563; line-height: 1.6; margin-bottom: 0.75rem;">
            Yaptığınız yazı ve logo değişikliklerinin Vercel'de kalıcı olması ve sayfa yenilendiğinde sıfırlanmaması için Supabase'de <strong>site_settings</strong> tablosunun açılması gerekmektedir.
          </p>
          <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <a href="https://supabase.com/dashboard/project/cmcfnufmsqprwkmnwhbj/sql" target="_blank" class="btn-primary" style="padding: 0.45rem 1rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.4rem;">
              Supabase SQL Editor'ü Aç &rarr;
            </a>
            <span style="font-size: 0.8rem; color: #6B7280;">(sql/site_settings.sql kodunu oraya yapıştırıp Run'a basmanız yeterlidir)</span>
          </div>
        </div>
      </div>
    </div>
  <% } else if (typeof supabaseReady !== 'undefined' && supabaseReady) { %>
    <div style="background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; padding: 0.6rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Supabase Veritabanı Bağlantısı: Aktif (Tüm ayarlar ve içerikler kalıcı olarak korunuyor)
    </div>
  <% } %>

  <!-- EASY TAB NAVIGATION -->
  <div class="settings-tabs-nav">
    <button type="button" class="tab-btn active" onclick="switchTab('tab-brand')">1. Logo & Marka</button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-hero')">2. Ana Sayfa & Slaytlar</button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-features')">3. Özellikler & Kampanya</button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-pages')">4. Menü & Hakkımızda</button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-contact')">5. İletişim & Konum</button>
  </div>

  <form id="settingsForm" action="/admin/settings" method="POST" enctype="multipart/form-data">

    <!-- TAB 1: LOGO & MARKA ADI -->
    <div id="tab-brand" class="settings-tab-pane active">
      <div class="admin-card">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Sitenin Sol Üstündeki Logo & Kafe Adı
        </h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
          Ziyaretçilerinizin sitenin en sol üst köşesinde göreceği kafe adını ve özel logonuzu buradan ayarlayabilirsiniz.
        </p>

        <div class="form-group">
          <label class="form-label">
            <span class="location-badge">📍 Sol Üst & Footer</span> Kafe Adı
          </label>
          <input type="text" name="cafe_name" class="form-input" value="<%= settings.cafe_name || 'Qfi Cafe' %>" required>
        </div>

        <div class="form-group" style="background: #F9F7F4; padding: 1.25rem; border-radius: var(--radius-md); border: 1px dashed var(--border-light);">
          <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span><span class="location-badge">📍 Sol Üst Menü</span> Özel Kafe Logosu (İsteğe Bağlı)</span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Boş bırakılırsa standart şık kahve ikonu görünür</span>
          </label>
          <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
            <div style="width: 100px; height: 70px; border-radius: 8px; background: #fff; border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; padding: 0.5rem; overflow: hidden;">
              <img id="preview_logo" src="<%= settings.logo_url || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=200' %>" alt="Logo" style="max-height: 100%; max-width: 100%; object-fit: contain;">
            </div>
            <div style="flex: 1; min-width: 220px;">
              <input type="file" name="logo_image" class="form-input crop-input" accept="image/*" data-aspect-ratio="1" data-preview-id="preview_logo">
              <div style="display: flex; gap: 1rem; align-items: center; margin-top: 0.5rem;">
                <span style="font-size: 0.8rem; color: var(--text-muted);">Şeffaf PNG veya kare JPG logo önerilir.</span>
                <% if (settings.logo_url) { %>
                  <label style="font-size: 0.8rem; color: var(--accent-red); cursor: pointer; display: flex; align-items: center; gap: 0.3rem;">
                    <input type="checkbox" name="remove_logo" value="true">
                    Logoyu kaldır (Varsayılan ikona dön)
                  </label>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: ANA SAYFA & FOTOĞRAF SLAYTLARI (CAROUSEL) -->
    <div id="tab-hero" class="settings-tab-pane">
      <div class="admin-card" style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Ana Sayfa Manşet Metinleri & Butonları
        </h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
          Ziyaretçilerinizin siteye ilk girdiğinde gördüğü karşılama metinleri.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label">
              <span class="location-badge">📍 Başlığın Üstündeki Rozet</span> Küçük Etiket
            </label>
            <input type="text" name="hero_badge" class="form-input" value="<%= settings.hero_badge || "Pendik'in En Sevilen Butik Kafesi" %>">
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="location-badge">📍 En Büyük Manşet</span> Ana Başlık
            </label>
            <input type="text" name="hero_title" class="form-input" value="<%= settings.hero_title || 'Sıcak Bir Kahve, Eşsiz Lezzetler.' %>" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">
            <span class="location-badge">📍 Başlığın Altı</span> Açıklama Paragrafı
          </label>
          <textarea name="hero_subtitle" class="form-textarea" rows="2"><%= settings.hero_subtitle %></textarea>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label">
              <span class="location-badge">📍 1. Buton Yazısı</span> Yeşil Buton
            </label>
            <input type="text" name="hero_btn1_text" class="form-input" value="<%= settings.hero_btn1_text || 'Lezzet Menüsü' %>">
          </div>

          <div class="form-group">
            <label class="form-label">
              <span class="location-badge">📍 2. Buton Yazısı</span> Çerçeveli Buton
            </label>
            <input type="text" name="hero_btn2_text" class="form-input" value="<%= settings.hero_btn2_text || 'Bize Ulaşın' %>">
          </div>
        </div>
      </div>

      <!-- 5 HERO SLIDER IMAGES UPLOADER -->
      <div class="admin-card">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Ana Sayfa Otomatik Slayt Gösterisi Fotoğrafları (5 Adet)
        </h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
          Ana sayfada 4-5 saniyede bir yumuşak geçişle değişecek fotoğraflar. Hem masaüstü hem de mobil tasarımda sıfır taşma ve sıkışma olmadan tam sığması için 4:3 oranında kırpılır.
        </p>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <% for (let i = 1; i <= 5; i++) { 
               const slideKey = 'hero_slide_' + i;
               const slideVal = settings[slideKey];
          %>
            <div style="background: #FAF8F5; padding: 1rem 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light); display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;">
              <div style="width: 120px; height: 90px; border-radius: 8px; overflow: hidden; background: #eee; flex-shrink: 0; border: 1px solid var(--border-light);">
                <img id="preview_slide_<%= i %>" src="<%= slideVal %>" alt="Slayt <%= i %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <div style="flex: 1; min-width: 220px;">
                <label style="font-size: 0.9rem; font-weight: 700; color: var(--text-dark); display: block; margin-bottom: 0.35rem;">
                  <%= i %>. Slayt Fotoğrafı (4:3 Oranında)
                </label>
                <input type="file" name="<%= slideKey %>" class="form-input crop-input" accept="image/*" data-aspect-ratio="1.3333" data-preview-id="preview_slide_<%= i %>">
                <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 0.25rem;">
                  Slayt alanına tam oturacak şekilde 4:3 oranında kırpılır. Değiştirmek istemiyorsanız boş bırakın.
                </span>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- TAB 3: ÖZELLİKLER & KAMPANYA -->
    <div id="tab-features" class="settings-tab-pane">
      <div class="admin-card" style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Ana Sayfadaki 3 Özellik Kutusu
        </h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
          Manşetin hemen altında yan yana duran 3 kutunun yazıları:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
          <div style="background: #F9F7F4; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
            <div style="font-weight: 700; color: var(--primary); margin-bottom: 0.5rem;">1. Kutu</div>
            <div class="form-group">
              <label class="form-label">Başlık</label>
              <input type="text" name="feature_1_title" class="form-input" value="<%= settings.feature_1_title %>">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Açıklama</label>
              <textarea name="feature_1_desc" class="form-textarea" rows="2"><%= settings.feature_1_desc %></textarea>
            </div>
          </div>

          <div style="background: #F9F7F4; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
            <div style="font-weight: 700; color: var(--accent-brown); margin-bottom: 0.5rem;">2. Kutu</div>
            <div class="form-group">
              <label class="form-label">Başlık</label>
              <input type="text" name="feature_2_title" class="form-input" value="<%= settings.feature_2_title %>">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Açıklama</label>
              <textarea name="feature_2_desc" class="form-textarea" rows="2"><%= settings.feature_2_desc %></textarea>
            </div>
          </div>

          <div style="background: #F9F7F4; padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-light);">
            <div style="font-weight: 700; color: var(--primary); margin-bottom: 0.5rem;">3. Kutu</div>
            <div class="form-group">
              <label class="form-label">Başlık</label>
              <input type="text" name="feature_3_title" class="form-input" value="<%= settings.feature_3_title %>">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Açıklama</label>
              <textarea name="feature_3_desc" class="form-textarea" rows="2"><%= settings.feature_3_desc %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- SPOTLIGHT KAMPANYA ALANI -->
      <div class="admin-card">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Günün Öne Çıkanı / Kampanya Vitrini
        </h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">
          Ana sayfada yer alan büyük koyu yeşil vitrin kutusu.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label">Rozet Metni</label>
            <input type="text" name="spotlight_badge" class="form-input" value="<%= settings.spotlight_badge || 'Haftanın Özel Önerisi' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Kampanya Başlığı</label>
            <input type="text" name="spotlight_title" class="form-input" value="<%= settings.spotlight_title || 'Iced Spanish Latte & San Sebastian' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Açıklama</label>
          <textarea name="spotlight_description" class="form-textarea" rows="2"><%= settings.spotlight_description %></textarea>
        </div>

        <div class="form-group" style="background: #F9F7F4; padding: 1rem 1.25rem; border-radius: var(--radius-md); border: 1px dashed var(--border-light);">
          <label class="form-label">Vitrin Fotoğrafı</label>
          <div style="display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;">
            <div style="width: 120px; height: 90px; border-radius: 8px; overflow: hidden; background: #eee; flex-shrink: 0; border: 1px solid var(--border-light);">
              <img id="preview_spotlight" src="<%= settings.spotlight_image %>" alt="Spotlight Preview" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="flex: 1; min-width: 220px;">
              <input type="file" name="spotlight_image" class="form-input crop-input" accept="image/*" data-aspect-ratio="1.333" data-preview-id="preview_spotlight">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: MENÜ & HAKKIMIZDA SAYFALARI -->
    <div id="tab-pages" class="settings-tab-pane">
      <div class="admin-card" style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.25rem; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/></svg>
          Menü Sayfası & Galeri Başlıkları
