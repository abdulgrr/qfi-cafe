<%- include('../partials/header') %>

<main class="page-container">
  <div class="page-card">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h1 class="page-title"><%= settings.about_title || 'Kahve Tutkumuz ve Hikayemiz' %></h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">
        <%= settings.about_subtitle || "Qfi Cafe olarak Pendik'te misafirlerimize unutulmaz bir lezzet ve kahve deneyimi sunuyoruz." %>
      </p>
    </div>

    <div class="responsive-two-col" style="margin-bottom: 3.5rem;">
      <div>
        <h3 style="font-family: var(--font-serif); font-size: 1.7rem; margin-bottom: 1rem; color: var(--primary);">
          <%= settings.about_sec1_title || 'Özenle Seçilmiş 3. Nesil Çekirdekler' %>
        </h3>
        <p style="color: var(--text-muted); line-height: 1.8; margin-bottom: 1rem;">
          <%= settings.about_story_1 %>
        </p>
        <p style="color: var(--text-muted); line-height: 1.8;">
          Espresso bazlı sıcak içeceklerimizden, 24 saat soğuk demlenen Cold Brew çeşitlerimize kadar her yudumda kaliteyi hissedeceksiniz.
        </p>
      </div>
      <div class="about-img-box">
        <img src="<%= settings.about_image_1 || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80' %>" alt="Qfi Cafe Barista">
      </div>
    </div>

    <div class="responsive-two-col" style="margin-bottom: 3rem;">
      <div class="about-img-box">
        <img src="<%= settings.about_image_2 || 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=800&q=80' %>" alt="Qfi Cafe Bakery">
      </div>
      <div>
        <h3 style="font-family: var(--font-serif); font-size: 1.7rem; margin-bottom: 1rem; color: var(--primary);">
          <%= settings.about_sec2_title || 'Günlük Taze Fırın Lezzetleri' %>
        </h3>
        <p style="color: var(--text-muted); line-height: 1.8; margin-bottom: 1rem;">
          <%= settings.about_story_2 %>
        </p>
        <p style="color: var(--text-muted); line-height: 1.8;">
          Siz de Pendik'teki sıcak atmosferimizde yerinizi alın, taze bir kahve eşliğinde anın tadını çıkarın.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/menu" class="btn-primary">Lezzet Menümüzü İnceleyin &rarr;</a>
      <a href="<%= (typeof settings !== 'undefined' && settings.instagram_url) ? settings.instagram_url : 'https://www.instagram.com/qficafe/' %>" target="_blank" rel="noopener noreferrer" class="btn-instagram" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.6rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        <span>Instagram (@qficafe)</span>
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
