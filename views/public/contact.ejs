<%- include('../partials/header') %>

<main class="page-container">
  <div class="page-card">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 class="page-title">Bize Ulaşın & Konum</h1>
      <p style="color: var(--text-muted); font-size: 1.05rem;">
        Sizi Pendik'teki mekanımızda taze bir kahve eşliğinde ağırlamaktan mutluluk duyarız.
      </p>
    </div>

    <!-- CONTACT CARDS -->
    <div class="contact-grid">
      <div class="contact-item">
        <h4>📍 Adresimiz</h4>
        <p style="color: var(--text-dark); font-weight: 600; margin-top: 0.4rem;">
          <%= cafeInfo.address %>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
          Pendik / İstanbul
        </p>
        <a href="<%= cafeInfo.mapsUrl %>" target="_blank" class="btn-primary" style="display: inline-block; margin-top: 1rem; padding: 0.55rem 1.1rem; font-size: 0.85rem;">
          🗺️ Google Maps Yol Tarifi &rarr;
        </a>
      </div>

      <div class="contact-item">
        <h4>📞 Telefon & İletişim</h4>
        <p style="color: var(--text-dark); font-weight: 700; font-size: 1.1rem; margin-top: 0.4rem;">
          <a href="tel:<%= cafeInfo.phoneRaw %>"><%= cafeInfo.phone %></a>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.4rem;">
          Rezervasyon ve bilgi almak için arayabilirsiniz.
        </p>
      </div>

      <div class="contact-item">
        <h4>⏰ Çalışma Saatleri</h4>
        <p style="color: var(--text-dark); font-weight: 600; margin-top: 0.4rem;">
          <%= cafeInfo.hours %>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.4rem;">
          Haftanın 7 günü hizmetinizdeyiz.
        </p>
      </div>
    </div>

    <!-- ACCURATE GOOGLE MAPS EMBED -->
    <div style="margin-top: 2.5rem; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
      <iframe 
        src="https://maps.google.com/maps?q=Dumlup%C4%B1nar%2C+Sahaf+Sk+No%3A3+D%3AA%2C+34000+Pendik%2F%C4%B0stanbul&t=&z=16&ie=UTF8&iwloc=&output=embed" 
        width="100%" 
        height="380" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
