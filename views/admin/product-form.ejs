<%- include('../partials/header') %>

<!-- CROPPER.JS ASSETS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<main class="admin-container" style="max-width: 680px;">
  <div class="admin-card">
    <div style="margin-bottom: 2rem;">
      <a href="/admin/dashboard" style="color: var(--text-muted); font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Panele Dön
      </a>
      <h2 style="font-family: var(--font-serif); font-size: 2rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <% if (product) { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Ürünü Düzenle
        <% } else { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Ürün Ekle
        <% } %>
      </h2>
    </div>

    <form id="productForm" action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data">
      <% if (product) { %>
        <input type="hidden" name="existing_image" value="<%= product.image_url %>">
        <input type="hidden" name="existing_cloudinary_id" value="<%= product.cloudinary_public_id %>">
      <% } %>

      <div class="form-group">
        <label class="form-label" for="name">Ürün Adı *</label>
        <input type="text" id="name" name="name" class="form-input" required value="<%= product ? product.name : '' %>" placeholder="Örn: Flat White">
      </div>

      <div class="form-group">
        <label class="form-label" for="category_id">Kategori *</label>
        <select id="category_id" name="category_id" class="form-select" required>
          <option value="">Kategori Seçin...</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= product && product.category_id === cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="price">Fiyat (TL) *</label>
        <input type="number" step="0.5" id="price" name="price" class="form-input" required value="<%= product ? product.price : '' %>" placeholder="140.00">
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Açıklama / İçerik</label>
        <textarea id="description" name="description" class="form-textarea" rows="3" placeholder="Çifte shot espresso ve özel köpürtülmüş taze süt..."><%= product ? product.description : '' %></textarea>
      </div>

      <!-- CUSTOM TAGS / BADGES SELECTION -->
      <div class="form-group">
        <label class="form-label" for="tags">Ürün Rozetleri / Etiketleri (İsteğe Bağlı)</label>
        <input type="text" id="tags" name="tags" class="form-input" value="<%= product && product.tags ? product.tags : '' %>" placeholder="Örn: Soğuk Demleme, Glutensiz">
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;">
          Virgülle ayırarak istediğiniz etiketleri yazabilir veya aşağıdaki hızlı butonlara tıklayabilirsiniz:
        </div>
        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem;">
          <button type="button" class="quick-tag-btn" onclick="addTag('Taze Demleme')">+ Taze Demleme</button>
          <button type="button" class="quick-tag-btn" onclick="addTag('Soğuk Servis')">+ Soğuk Servis</button>
          <button type="button" class="quick-tag-btn" onclick="addTag('Sıcak Servis')">+ Sıcak Servis</button>
          <button type="button" class="quick-tag-btn" onclick="addTag('Glutensiz')">+ Glutensiz</button>
          <button type="button" class="quick-tag-btn" onclick="addTag('Şekersiz')">+ Şekersiz</button>
          <button type="button" class="quick-tag-btn" onclick="addTag('Özel Tarif')">+ Özel Tarif</button>
          <button type="button" class="quick-tag-btn" style="color: var(--accent-red); border-color: #FCA5A5;" onclick="clearTags()">Temizle</button>
        </div>
      </div>

      <!-- IMAGE UPLOAD WITH AUTOMATIC CROPPER MODAL -->
      <div class="form-group">
        <label class="form-label" for="productImageInput">Ürün Fotoğrafı</label>
        <div style="display: flex; gap: 1.25rem; align-items: center; margin-bottom: 0.75rem; background: #FAF8F5; padding: 1rem; border-radius: var(--radius-md); border: 1px dashed var(--border-light);">
          <div style="width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: #eee; flex-shrink: 0; border: 1px solid var(--border-light);">
            <img id="productImagePreview" src="<%= product && product.image_url ? product.image_url : 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=600' %>" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="flex: 1;">
            <input type="file" id="productImageInput" name="image" class="form-input" accept="image/*">
            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-top: 0.35rem;">
              Dosya seçtiğinizde fotoğrafı tam kare oranında kırpabilmeniz için kırpma aracı açılacaktır.
            </span>
          </div>
        </div>
      </div>

      <div class="form-group" style="display: flex; gap: 1.5rem; margin-top: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="is_available" name="is_available" <%= !product || product.is_available ? 'checked' : '' %> style="width: 18px; height: 18px;">
          <label for="is_available" style="font-weight: 600; cursor: pointer;">Stokta Var (Menüde Görünsün)</label>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="display_order">Menü Gösterim Sırası</label>
        <input type="number" id="display_order" name="display_order" class="form-input" value="<%= product ? product.display_order : 0 %>">
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button type="submit" class="btn-primary" style="flex: 1;">
          <%= product ? 'Kaydet & Güncelle' : 'Ürünü Kaydet' %>
        </button>
        <a href="/admin/dashboard" class="btn-outline" style="text-align: center;">İptal</a>
      </div>
    </form>
  </div>
</main>

<!-- CROPPER MODAL DIALOG -->
<div id="cropperModal" class="cropper-modal-overlay" style="display: none;">
  <div class="cropper-modal-container">
    <div class="cropper-modal-header">
      <h3 style="font-size: 1.15rem; color: var(--text-dark); margin: 0; display: flex; align-items: center; gap: 0.4rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
        Fotoğrafı Kırp & Ayarla (1:1 Kare)
      </h3>
      <button type="button" id="closeCropperBtn" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>
    <div class="cropper-modal-body">
      <img id="cropperImageElement" src="" alt="Crop image">
    </div>
    <div class="cropper-modal-footer">
      <span style="font-size: 0.85rem; color: var(--text-muted);">
        Fareyi veya parmağınızı kaydırarak fotoğrafın görünmesini istediğiniz kısmını seçin.
      </span>
      <div style="display: flex; gap: 0.75rem;">
        <button type="button" class="btn-outline" id="cancelCropBtn" style="padding: 0.5rem 1.1rem; font-size: 0.9rem;">İptal</button>
        <button type="button" class="btn-primary" id="applyCropBtn" style="padding: 0.5rem 1.35rem; font-size: 0.9rem;">Kırp ve Kullan</button>
      </div>
    </div>
  </div>
</div>

<style>
  .quick-tag-btn {
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: 99px;
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary);
    cursor: pointer;
    transition: all 0.2s;
  }
  .quick-tag-btn:hover {
    background: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
  }
</style>

<script>
  function addTag(tag) {
    const input = document.getElementById('tags');
    const current = input.value.split(',').map(s => s.trim()).filter(Boolean);
    if (!current.includes(tag)) {
      current.push(tag);
      input.value = current.join(', ');
    }
  }

  function clearTags() {
    document.getElementById('tags').value = '';
  }

  // CROPPER LOGIC
  (function() {
    const fileInput = document.getElementById('productImageInput');
    const preview = document.getElementById('productImagePreview');
    const modal = document.getElementById('cropperModal');
    const cropperImg = document.getElementById('cropperImageElement');
    const applyBtn = document.getElementById('applyCropBtn');
    const cancelBtn = document.getElementById('cancelCropBtn');
    const closeBtn = document.getElementById('closeCropperBtn');

    let cropper = null;
    let originalFileName = 'product.jpg';

    fileInput.addEventListener('change', function(e) {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        originalFileName = file.name;
        const reader = new FileReader();
        reader.onload = function(evt) {
          cropperImg.src = evt.target.result;
          modal.style.display = 'flex';

          if (cropper) {
            cropper.destroy();
          }

          cropper = new Cropper(cropperImg, {
            aspectRatio: 1, // Square aspect ratio for menu cards
            viewMode: 1,
            autoCropArea: 0.9,
            responsive: true
          });
        };
        reader.readAsDataURL(file);
      }
    });

    function closeModal() {
      modal.style.display = 'none';
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    }

    cancelBtn.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);

    applyBtn.addEventListener('click', function() {
      if (!cropper) return;

      const canvas = cropper.getCroppedCanvas({
        width: 800,
        height: 800,
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high'
      });

      canvas.toBlob(function(blob) {
        if (!blob) return;

        // Create new File and assign to file input via DataTransfer
        const croppedFile = new File([blob], originalFileName, { type: 'image/jpeg' });
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(croppedFile);
        fileInput.files = dataTransfer.files;

        // Update preview image
        preview.src = canvas.toDataURL('image/jpeg');
        closeModal();
      }, 'image/jpeg', 0.9);
    });
  })();
</script>

<%- include('../partials/footer') %>
