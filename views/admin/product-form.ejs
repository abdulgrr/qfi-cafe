<%- include('../partials/header') %>

<main class="admin-container" style="max-width: 680px;">
  <div class="admin-card">
    <div style="margin-bottom: 2rem;">
      <a href="/admin/dashboard" style="color: var(--text-muted); font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Panele Dön
      </a>
      <h2 style="font-family: var(--font-serif); font-size: 2rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <% if (product) { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Ürünü Düzenle
        <% } else { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Ürün Ekle
        <% } %>
      </h2>
    </div>

    <form action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data">
      <% if (product) { %>
        <input type="hidden" name="existing_image" value="<%= product.image_url %>">
        <input type="hidden" name="existing_cloudinary_id" value="<%= product.cloudinary_public_id %>">
      <% } %>

      <div class="form-group">
        <label class="form-label" for="name">Ürün Adı *</label>
        <input type="text" id="name" name="name" class="form-input" required value="<%= product ? product.name : '' %>" placeholder="Örn: Flat White">
      </div>

      <div class="form-group">
        <label class="form-label" for="category_id">Kategori *</label>
        <select id="category_id" name="category_id" class="form-select" required>
          <option value="">Kategori Seçin...</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= product && product.category_id === cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="price">Fiyat (TL) *</label>
        <input type="number" step="0.5" id="price" name="price" class="form-input" required value="<%= product ? product.price : '' %>" placeholder="140.00">
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Açıklama / İçerik</label>
        <textarea id="description" name="description" class="form-textarea" rows="3" placeholder="Çifte shot espresso ve özel köpürtülmüş taze süt..."><%= product ? product.description : '' %></textarea>
      </div>

      <!-- CLOUDINARY FILE UPLOAD SECTION -->
      <div class="form-group">
        <label class="form-label" for="image">Ürün Görseli (Cloudinary'ye Otomatik Yüklenir)</label>
        <% if (product && product.image_url) { %>
          <div style="margin-bottom: 1rem; display: flex; align-items: center; gap: 1rem; background: #F9FAFB; padding: 0.75rem; border-radius: var(--radius-sm);">
            <img src="<%= product.image_url %>" alt="Mevcut Görsel" style="width: 70px; height: 70px; border-radius: 8px; object-fit: cover;">
            <div>
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-dark);">Mevcut Görsel</span>
              <p style="font-size: 0.75rem; color: var(--text-muted);">Yeni bir dosya seçmezseniz bu görsel korunur.</p>
            </div>
          </div>
        <% } %>
        <input type="file" id="image" name="image" class="form-input" accept="image/*">
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">
          Görseller otomatik olarak Cloudinary CDN'ine yüklenir ve optimize edilir.
        </p>
      </div>

      <div class="form-group" style="display: flex; gap: 1.5rem; margin-top: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="is_available" name="is_available" <%= !product || product.is_available ? 'checked' : '' %> style="width: 18px; height: 18px;">
          <label for="is_available" style="font-weight: 600; cursor: pointer;">Stokta Var (Menüde Görünsün)</label>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="display_order">Menü Gösterim Sırası</label>
        <input type="number" id="display_order" name="display_order" class="form-input" value="<%= product ? product.display_order : 0 %>">
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 2rem;">
        <button type="submit" class="btn-primary" style="flex: 1;">
          <%= product ? 'Kaydet & Güncelle' : 'Ürünü Kaydet' %>
        </button>
        <a href="/admin/dashboard" class="btn-outline" style="text-align: center;">İptal</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
