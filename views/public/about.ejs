<%- include('../partials/header') %>

<main class="page-container">
  <div class="page-card">
    <div class="page-header-box">
      <h1 class="page-title"><%= settings.about_title || 'Kahve Tutkumuz ve Hikayemiz' %></h1>
      <p class="page-subtitle">
        <%= settings.about_subtitle || "Qfi Cafe olarak Pendik'te misafirlerimize unutulmaz bir lezzet ve kahve deneyimi sunuyoruz." %>
      </p>
    </div>

    <div class="responsive-two-col about-story-row">
      <div class="about-text-col">
        <h3 class="about-story-title">
          <%= settings.about_sec1_title || 'Özenle Seçilmiş 3. Nesil Çekirdekler' %>
        </h3>
        <p class="about-story-p">
          <%= settings.about_story_1 %>
        </p>
        <p class="about-story-p">
          Espresso bazlı sıcak içeceklerimizden, 24 saat soğuk demlenen Cold Brew çeşitlerimize kadar her yudumda kaliteyi hissedeceksiniz.
        </p>
      </div>
      <div class="about-img-box">
        <img src="<%= settings.about_image_1 || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80' %>" alt="Qfi Cafe Barista">
      </div>
    </div>

    <div class="responsive-two-col about-story-row">
      <div class="about-img-box">
        <img src="<%= settings.about_image_2 || 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=800&q=80' %>" alt="Qfi Cafe Bakery">
      </div>
      <div class="about-text-col">
        <h3 class="about-story-title">
          <%= settings.about_sec2_title || 'Günlük Taze Fırın Lezzetleri' %>
        </h3>
        <p class="about-story-p">
          <%= settings.about_story_2 %>
        </p>
        <p class="about-story-p">
          Siz de Pendik'teki sıcak atmosferimizde yerinizi alın, taze bir kahve eşliğinde anın tadını çıkarın.
        </p>
      </div>
    </div>

    <div class="about-footer-action">
      <a href="/menu" class="btn-primary">Lezzet Menümüzü İnceleyin &rarr;</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
