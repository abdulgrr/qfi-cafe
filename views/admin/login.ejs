<%- include('../partials/header') %>

<main class="admin-container" style="max-width: 440px;">
  <div class="admin-card" style="margin-top: 4rem;">
    <h2 style="font-family: var(--font-serif); text-align: center; margin-bottom: 1.5rem; font-size: 1.8rem;">
      🔐 Admin Girişi
    </h2>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #FEE2E2; color: #991B1B; padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.25rem; font-weight: 600; font-size: 0.9rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="username">Kullanıcı Adı</label>
        <input type="text" id="username" name="username" class="form-input" required placeholder="admin">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Şifre</label>
        <input type="password" id="password" name="password" class="form-input" required placeholder="••••••••">
      </div>

      <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">
        Giriş Yap
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
