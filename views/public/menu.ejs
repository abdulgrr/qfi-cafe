<%- include('../partials/header') %>

<main>
  <div class="menu-header-box">
    <div class="menu-title-badge">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/></svg>
      <span>Taze & Günlük Butik Seçkiler</span>
    </div>
    <h1 class="menu-main-title">
      <%= (typeof settings !== 'undefined' && settings.menu_title) ? settings.menu_title : 'Kahve & Lezzet Menüsü' %>
    </h1>
    <p class="menu-main-subtitle">
      <%= (typeof settings !== 'undefined' && settings.menu_subtitle) ? settings.menu_subtitle : 'Özenle seçilmiş kahvelerimiz ve her gün fırından taze çıkan lezzetlerimiz' %>
    </p>

    <!-- SEARCH BAR -->
    <div class="search-box-container">
      <span class="search-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="text" id="menu-search-input" class="search-input" placeholder="Kahve, kruvasan veya tatlı ara..." autocomplete="off">
    </div>
  </div>

  <!-- CATEGORY PILL NAVIGATION BAR -->
  <div class="category-bar-wrapper">
    <div class="category-bar">
      <button class="category-pill <%= selectedCategory === 'all' ? 'active' : '' %>" data-category="all">
        Tümü (<%= products.length %>)
      </button>
      <% categories.forEach(cat => { %>
        <% const catProductCount = products.filter(p => p.category_id === cat.id || (p.categories && p.categories.id === cat.id)).length; %>
        <button class="category-pill <%= selectedCategory === cat.slug ? 'active' : '' %>" data-category="<%= cat.slug %>">
          <%= cat.name %> <% if (catProductCount > 0) { %><span class="pill-count">(<%= catProductCount %>)</span><% } %>
        </button>
      <% }) %>
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <section class="product-section">
    <% if (products.length === 0) { %>
      <div class="empty-menu-state">
        <div class="empty-icon-box">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
        </div>
        <p style="font-size: 1.2rem; font-weight: 700; color: var(--text-dark);">Menüde henüz ürün bulunmuyor.</p>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 0.35rem;">Yönetim panelinden dilediğiniz lezzetleri ekleyebilirsiniz.</p>
      </div>
    <% } else { %>
      <div class="product-grid" id="product-grid-container">
        <% products.forEach(product => { %>
          <% 
            const catName = product.categories ? product.categories.name : 'Özel Seçim';
            const catSlug = product.categories ? product.categories.slug : '';
            const isOutOfStock = !product.is_available;
            const tagList = (product.tags && product.tags.trim()) 
              ? product.tags.split(',').map(t => t.trim()).filter(Boolean) 
              : [];
          %>
          <div class="product-card boutique-card <%= isOutOfStock ? 'is-out-of-stock' : '' %>" 
               data-category-slug="<%= catSlug %>" 
               data-product-name="<%= product.name.toLowerCase() %>" 
               data-product-desc="<%= (product.description || '').toLowerCase() %>"
               data-product-tags="<%= (product.tags || '').toLowerCase() %>">
            
            <div class="boutique-img-wrapper">
              <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=600' %>" 
                   alt="<%= product.name %>" 
                   class="boutique-img <%= isOutOfStock ? 'out-of-stock-img' : '' %>" 
                   loading="lazy">
              
              <% if (isOutOfStock) { %>
                <div class="out-of-stock-overlay-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                  <span>Stokta Yok</span>
                </div>
              <% } %>
            </div>
            
            <div class="boutique-card-body">
              <div class="boutique-card-top-row">
                <span class="boutique-cat-badge"><%= catName %></span>
                <span class="boutique-price-badge <%= isOutOfStock ? 'price-muted' : '' %>">
                  <span class="currency-sym">₺</span><%= parseFloat(product.price).toFixed(2) %>
                </span>
              </div>
              
              <h3 class="boutique-product-title"><%= product.name %></h3>
              
              <p class="boutique-product-desc">
                <%= product.description || 'Özel çekirdek ve günlük malzemelerle taze hazırlanan butik lezzet.' %>
              </p>
              
              <% if (tagList.length > 0) { %>
                <div class="boutique-tags-row">
                  <% tagList.forEach(tag => { %>
                    <span class="boutique-tag-pill">
                      <span class="tag-dot"></span>
                      <%= tag %>
                    </span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
