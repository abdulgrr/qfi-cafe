<%- include('../partials/header') %>

<main>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-text">
      <h1>Sıcak Bir Kahve, <span>Eşsiz Tatlar.</span></h1>
      <p>Pendik'in kalbinde özenle seçilmiş 3. nesil kahve çekirdekleri, taze pişen boutique tatlılar ve huzur dolu atmosfer Qfi Coffee'de sizi bekliyor.</p>
      <div class="hero-actions">
        <a href="/menu" class="btn-primary">☕ Lezzet Menüsü</a>
        <a href="/contact" class="btn-outline">📍 Konum ve İletişim</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-img-box">
        <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=900&q=80" alt="Qfi Coffee Interior">
      </div>
    </div>
  </section>

  <!-- FEATURED HIGHLIGHTS -->
  <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
    <section class="product-section">
      <div style="text-align: center; margin-bottom: 2rem;">
        <h2 style="font-family: var(--font-serif); font-size: 2.3rem;">Öne Çıkan Lezzetlerimiz</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Günlük taze hazırlanan favori kahve ve tatlılarımız</p>
      </div>
      <div class="product-grid">
        <% featuredProducts.forEach(product => { %>
          <div class="product-card">
            <div class="product-img-wrapper">
              <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=600' %>" alt="<%= product.name %>" class="product-img" loading="lazy">
            </div>
            <div class="product-details">
              <div class="product-title-row">
                <h3 class="product-name"><%= product.name %></h3>
                <span class="product-price">₺<%= parseFloat(product.price).toFixed(2) %></span>
              </div>
              <p class="product-desc"><%= product.description %></p>
              <div class="product-size-row">
                <span class="size-pill">Taze Demleme</span>
                <span class="size-pill">Standart</span>
              </div>
              <div class="product-card-footer">
                <span class="status-badge <%= product.is_available ? 'available' : 'out' %>">
                  <%= product.is_available ? 'Mevcut' : 'Tükendi' %>
                </span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/menu" class="btn-primary" style="display: inline-block;">Tüm Menüyü İncele &rarr;</a>
      </div>
    </section>
  <% } %>

  <!-- ABOUT & LOCATION BANNER -->
  <section class="page-container" style="margin-top: 2rem;">
    <div class="page-card" style="text-align: center;">
      <h2 style="font-family: var(--font-serif); font-size: 2rem; margin-bottom: 1rem; color: var(--primary);">
        Qfi Coffee'ye Davetlisiniz
      </h2>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto 1.5rem; line-height: 1.7;">
        Dumlupınar, Sahaf Sokak'ta yer alan kafemizde taze kavrulmuş kahvelerimiz ve lezzetli ikramlarımız ile gününüze keyif katıyoruz.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/about" class="btn-outline">Hakkımızda Daha Fazla</a>
        <a href="/contact" class="btn-primary">Haritada Yol Tarifi Al</a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
