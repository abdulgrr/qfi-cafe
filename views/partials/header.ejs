<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Qfi Cafe | Pendik Butik Cafe' %></title>
  <meta name="description" content="Qfi Cafe - Pendik/İstanbul. Özel 3. nesil kahveler, taze fırın tatlıları ve benzersiz atmosfer.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="brand-logo" style="display: inline-flex; align-items: center; gap: 0.6rem;">
        <% if (typeof settings !== 'undefined' && settings.logo_url) { %>
          <img src="<%= settings.logo_url %>" alt="<%= (typeof settings !== 'undefined' && settings.cafe_name) ? settings.cafe_name : 'Qfi Cafe' %>" style="max-height: 38px; width: auto; object-fit: contain;">
        <% } else { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
        <% } %>
        <span><%= (typeof settings !== 'undefined' && settings.cafe_name) ? settings.cafe_name : 'Qfi Cafe' %></span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">Anasayfa</a></li>
        <li><a href="/menu" class="nav-link">Menü</a></li>
        <li><a href="/about" class="nav-link">Hakkımızda</a></li>
        <li><a href="/contact" class="nav-link">İletişim</a></li>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <li><a href="/admin/dashboard" class="nav-link" style="color: var(--primary);">Yönetim Paneli</a></li>
          <li><a href="/admin/logout" class="nav-link" style="color: var(--accent-red);">Çıkış</a></li>
        <% } %>
      </ul>

      <!-- RIGHT HEADER ACTIONS (Instagram, Desktop QR Button & Mobile Call Button) -->
      <div class="nav-right-actions">
        <a href="<%= (typeof settings !== 'undefined' && settings.instagram_url) ? settings.instagram_url : 'https://www.instagram.com/qficafe/' %>" target="_blank" rel="noopener noreferrer" class="btn-instagram desktop-header-instagram" aria-label="Qfi Cafe Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          <span>Instagram</span>
        </a>
        <a href="/menu" class="btn-primary desktop-header-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
          QR Menü
        </a>
        <a href="<%= (typeof settings !== 'undefined' && settings.instagram_url) ? settings.instagram_url : 'https://www.instagram.com/qficafe/' %>" target="_blank" rel="noopener noreferrer" class="mobile-header-instagram" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
        <a href="tel:<%= (typeof settings !== 'undefined' && settings.phone_raw) ? settings.phone_raw : '05015580958' %>" class="mobile-header-call" aria-label="Hemen Ara">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
    </div>
  </nav>
