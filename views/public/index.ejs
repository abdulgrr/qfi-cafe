<%- include('../partials/header') %>

<main>
  <!-- HERO SECTION WITH SMOOTH SLIDESHOW CAROUSEL -->
  <section class="hero">
    <div class="hero-text">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        <span><%= settings.hero_badge || "Pendik'in En Sevilen Butik Kafesi" %></span>
      </div>
      <h1><%= settings.hero_title || 'Sıcak Bir Kahve, Eşsiz Lezzetler.' %></h1>
      <p><%= settings.hero_subtitle %></p>
      <div class="hero-actions">
        <a href="/menu" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/></svg>
          <%= settings.hero_btn1_text || 'Lezzet Menüsü' %>
        </a>
        <a href="/contact" class="btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= settings.hero_btn2_text || 'Bize Ulaşın' %>
        </a>
      </div>
    </div>

    <!-- HERO SLIDER / SLAYT GÖSTERİSİ -->
    <div class="hero-image">
      <% 
        const configuredSlides = [
          settings.hero_slide_1,
          settings.hero_slide_2,
          settings.hero_slide_3,
          settings.hero_slide_4,
          settings.hero_slide_5
        ].filter(Boolean);
        const activeSlides = configuredSlides.length > 0 ? configuredSlides : [
          'https://images.unsplash.com/photo-1442512595331-e89e73853f31?w=1000&q=80',
          'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1000&q=80',
          'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1000&q=80',
          'https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=1000&q=80',
          'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=1000&q=80'
        ];
      %>
      <div class="hero-slider" id="heroSlider">
        <div class="hero-slides-wrapper">
          <% activeSlides.forEach((slideUrl, idx) => { %>
            <div class="hero-slide <%= idx === 0 ? 'active' : '' %>" data-slide-index="<%= idx %>">
              <img src="<%= slideUrl %>" alt="<%= settings.cafe_name || 'Qfi Cafe' %> - Görsel <%= idx + 1 %>">
            </div>
          <% }) %>
        </div>

        <!-- Slider Navigation Arrows -->
        <button type="button" class="slider-arrow slider-arrow-prev" id="heroPrevBtn" aria-label="Önceki Görsel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="slider-arrow slider-arrow-next" id="heroNextBtn" aria-label="Sonraki Görsel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>

        <!-- Slider Dots -->
        <div class="slider-dots" id="sliderDots">
          <% activeSlides.forEach((_, idx) => { %>
            <button type="button" class="slider-dot <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>" aria-label="Slayt <%= idx + 1 %>"></button>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES HIGHLIGHTS BAR -->
  <section class="features-section">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon" style="background: #E8F0EA; color: var(--primary);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
        </div>
        <div class="feature-body">
          <h4><%= settings.feature_1_title %></h4>
          <p><%= settings.feature_1_desc %></p>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background: #F5EBE6; color: var(--accent-brown);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="feature-body">
          <h4><%= settings.feature_2_title %></h4>
          <p><%= settings.feature_2_desc %></p>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background: #E8F0EA; color: var(--primary);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </div>
        <div class="feature-body">
          <h4><%= settings.feature_3_title %></h4>
          <p><%= settings.feature_3_desc %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS GRID -->
  <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
    <section class="product-section featured-section">
      <div class="section-title-box">
        <div class="section-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Barista Favorileri
        </div>
        <h2 class="section-main-title">Öne Çıkan Lezzetlerimiz</h2>
        <p class="section-main-desc">Özenle hazırladığımız en sevilen kahve ve boutique tatlılar</p>
      </div>
      <div class="product-grid">
        <% featuredProducts.forEach(product => { %>
          <% 
            const catName = product.categories ? product.categories.name : 'Özel Seçim';
            const isOutOfStock = !product.is_available;
            const tagList = (product.tags && product.tags.trim()) 
              ? product.tags.split(',').map(t => t.trim()).filter(Boolean) 
              : [];
          %>
          <div class="product-card boutique-card <%= isOutOfStock ? 'is-out-of-stock' : '' %>">
            <div class="boutique-img-wrapper">
              <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=600' %>" 
                   alt="<%= product.name %>" 
                   class="boutique-img <%= isOutOfStock ? 'out-of-stock-img' : '' %>" 
                   loading="lazy">
              
              <% if (isOutOfStock) { %>
                <div class="out-of-stock-overlay-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                  <span>Stokta Yok</span>
                </div>
              <% } %>
            </div>
            
            <div class="boutique-card-body">
              <div class="boutique-card-top-row">
                <span class="boutique-price-badge <%= isOutOfStock ? 'price-muted' : '' %>">
                  <span class="currency-sym">₺</span><%= parseFloat(product.price).toFixed(2) %>
                </span>
              </div>
              
              <h3 class="boutique-product-title"><%= product.name %></h3>
              
              <p class="boutique-product-desc">
                <%= product.description || 'Özel çekirdek ve günlük taze malzemelerle hazırlanan butik lezzet.' %>
              </p>
              
              <% if (tagList.length > 0) { %>
                <div class="boutique-tags-row">
                  <% tagList.forEach(tag => { %>
                    <span class="boutique-tag-pill" title="<%= tag %>">
                      <span class="tag-dot"></span>
                      <span class="tag-text"><%= tag %></span>
                    </span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="section-footer-action">
        <a href="/menu" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 2rem;">
          Tüm Menüyü İncele
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </section>
  <% } %>

  <!-- SPECIAL SPOTLIGHT SHOWCASE BANNER -->
  <section class="spotlight-section">
    <div class="spotlight-banner">
      <div class="spotlight-content">
        <div class="spotlight-badge">
          <%= settings.spotlight_badge || 'Günün Önerisi' %>
        </div>
        <h2 class="spotlight-title">
          <%= settings.spotlight_title || 'Iced Spanish Latte & San Sebastian' %>
        </h2>
        <p class="spotlight-desc">
          <%= settings.spotlight_description %>
        </p>
        <a href="/menu" class="btn-primary" style="background: #FAF7F2; color: var(--primary); border: none;">
          <%= settings.spotlight_button_text || 'Menüde Keşfet' %> &rarr;
        </a>
      </div>
      <div class="spotlight-image-box">
        <img src="<%= settings.spotlight_image || 'https://images.unsplash.com/photo-1533134242443-d4fd215305ad?w=900&q=80' %>" alt="<%= settings.spotlight_title %>">
      </div>
    </div>
  </section>

  <!-- INSTAGRAM FEED WIDGET (CANLI AKIŞ) -->
  <section class="instagram-feed-section" id="instagram-feed">
    <div class="instagram-widget-card">
      <div class="instagram-widget-header">
        <div class="insta-profile-info">
          <div class="insta-avatar-ring">
            <div class="insta-avatar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: #FFFFFF;"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </div>
          </div>
          <div>
            <div class="insta-username-row">
              <h3 class="insta-username">qficafe</h3>
              <span class="insta-verified-badge" title="Doğrulanmış Profil">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="#3897F0"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9" stroke="#FFFFFF" stroke-width="2.5" fill="none"/></svg>
              </span>
            </div>
            <p class="insta-bio">Qfi Cafe & Bakery • Pendik / İstanbul • En Son Paylaşımlarımız</p>
          </div>
        </div>
        <a href="https://www.instagram.com/qficafe/" target="_blank" rel="noopener noreferrer" class="btn-instagram-follow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          <span>Instagram'da Takip Et</span>
        </a>
      </div>

      <% 
        const postsList = (typeof instagramPosts !== 'undefined' && instagramPosts && instagramPosts.length > 0) 
          ? instagramPosts 
          : [
              'https://www.instagram.com/p/DZDmlKRseo2/',
              'https://www.instagram.com/reel/Da22bUnMZAg/',
              'https://www.instagram.com/reel/DZctUmzsvjY/',
              'https://www.instagram.com/p/DZPG2M_MQg6/'
            ];
      %>

      <!-- 4 CANLI INSTAGRAM GÖNDERİSİ (DİREKT EMBED İFRAME - ANINDA FOTOĞRAFLI & VİDEOLU YÜKLENİR) -->
      <div class="instagram-embeds-grid">
        <% postsList.forEach(function(postUrl, index) { %>
          <% if (postUrl && postUrl.trim()) { 
              const cleanBase = postUrl.trim().endsWith('/') ? postUrl.trim() : postUrl.trim() + '/';
              const embedUrl = cleanBase + 'embed/';
          %>
            <div class="instagram-embed-card">
              <iframe 
                src="<%= embedUrl %>" 
                class="instagram-direct-iframe"
                scrolling="no" 
                allowtransparency="true" 
                allowfullscreen="true"
                frameborder="0"
                title="Qfi Cafe Instagram Gönderisi <%= index + 1 %>"
                loading="lazy"
              ></iframe>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- LOCATION CTA BANNER -->
  <section class="page-container location-cta-section">
    <div class="page-card" style="text-align: center;">
      <h2 class="cta-banner-title">
        <%= settings.cafe_name || 'Qfi Cafe' %>'ye Bekliyoruz
      </h2>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto 1.5rem; line-height: 1.7;">
        <%= (typeof cafeInfo !== 'undefined' && cafeInfo.address) ? cafeInfo.address : 'Dumlupınar, Sahaf Sk No:3 D:A, Pendik/İstanbul' %> adresinde haftanın 7 günü <%= (typeof cafeInfo !== 'undefined' && cafeInfo.hours) ? cafeInfo.hours : '09:00 - 23:30' %> saatleri arasında kapılarımız açık.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Haritada Yol Tarifi Al
        </a>
        <a href="/about" class="btn-outline">Hakkımızda</a>
      </div>
    </div>
  </section>
</main>

<!-- HERO AUTO-SLIDER SCRIPT -->
<script>
  (function() {
    const slider = document.getElementById('heroSlider');
    if (!slider) return;

    const slides = slider.querySelectorAll('.hero-slide');
    const dots = slider.querySelectorAll('.slider-dot');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('active');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.add('active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('active');
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(nextSlide, 5000);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    // Arrow navigation buttons
    const prevBtn = document.getElementById('heroPrevBtn');
    const nextBtn = document.getElementById('heroNextBtn');
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        prevSlide();
        startTimer();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        nextSlide();
        startTimer();
      });
    }

    // Touch swipe gestures for mobile phones
    let touchStartX = 0;
    let touchEndX = 0;
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchStartX - touchEndX;
      if (swipeDistance > 45) {
        nextSlide(); // Swiped left -> next slide
        startTimer();
      } else if (swipeDistance < -45) {
        prevSlide(); // Swiped right -> prev slide
        startTimer();
      }
    }, { passive: true });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToSlide(idx);
        startTimer();
      });
    });

    slider.addEventListener('mouseenter', stopTimer);
    slider.addEventListener('mouseleave', startTimer);

    startTimer();
  })();
</script>

<%- include('../partials/footer') %>
