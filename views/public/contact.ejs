<%- include('../partials/header') %>

<main class="page-container">
  <div class="page-card">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 class="page-title">Bize Ulaşın & Konum</h1>
      <p style="color: var(--text-muted); font-size: 1.05rem;">
        Sizi Pendik'teki mekanımızda taze bir kahve eşliğinde ağırlamaktan mutluluk duyarız.
      </p>
    </div>

    <!-- CONTACT CARDS -->
    <div class="contact-grid">
      <div class="contact-item">
        <h4>📍 Adresimiz</h4>
        <p style="color: var(--text-dark); font-weight: 600; margin-top: 0.4rem;">
          <%= cafeInfo.address %>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
          Pendik, İstanbul
        </p>
        <a href="<%= cafeInfo.mapsUrl %>" target="_blank" class="btn-primary" style="display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem; font-size: 0.85rem;">
          🗺️ Google Maps'te Aç &rarr;
        </a>
      </div>

      <div class="contact-item">
        <h4>📞 Telefon & İletişim</h4>
        <p style="color: var(--text-dark); font-weight: 700; font-size: 1.1rem; margin-top: 0.4rem;">
          <a href="tel:<%= cafeInfo.phoneRaw %>"><%= cafeInfo.phone %></a>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.4rem;">
          Rezervasyon ve bilgi almak için arayabilirsiniz.
        </p>
      </div>

      <div class="contact-item">
        <h4>⏰ Çalışma Saatleri</h4>
        <p style="color: var(--text-dark); font-weight: 600; margin-top: 0.4rem;">
          <%= cafeInfo.hours %>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.4rem;">
          Haftanın 7 günü hizmetinizdeyiz.
        </p>
      </div>
    </div>

    <!-- GOOGLE MAPS EMBED -->
    <div style="margin-top: 3rem; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3015.6!2d29.231!3d40.875!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDDCsDUyJzMwLjAiTiAyOcKwMTMnNTEuNiJF!5e0!3m2!1str!2str!4v1620000000000!5m2!1str!2str" 
        width="100%" 
        height="360" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy">
      </iframe>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
